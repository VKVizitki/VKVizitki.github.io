assets/style.css
:root{
  --brand-orange:#E8461E;
  --brand-green:#4CAF2E;
  --brand-dark:#1f1f1f;
  --brand-light:#ffffff;
  --brand-gray:#f5f5f5;
  --radius:18px;
  --shadow:0 10px 30px rgba(0,0,0,.12);
}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Segoe UI',Roboto,Arial,sans-serif;}
body{
  min-height:100vh;
  background:linear-gradient(135deg,#fff 0%,#f7fff4 100%);
  display:flex;align-items:center;justify-content:center;
  padding:20px;color:var(--brand-dark);
  -webkit-tap-highlight-color:transparent;
}
.card{
  width:100%;max-width:420px;
  background:var(--brand-light);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  overflow:hidden;
  animation:cardIn .6s cubic-bezier(.2,.8,.2,1);
}
@keyframes cardIn{from{opacity:0;transform:translateY(30px) scale(.97);}to{opacity:1;transform:none;}}
.card__top{
  background:linear-gradient(135deg,var(--brand-orange),var(--brand-green));
  padding:22px 20px 70px;position:relative;
}
.card__logo{height:38px;display:block;}
.card__logo img{height:100%;}
.card__avatar{
  width:110px;height:110px;border-radius:50%;
  background:var(--brand-gray);border:5px solid #fff;
  box-shadow:0 8px 20px rgba(0,0,0,.15);
  margin:-70px auto 0;
  display:flex;align-items:center;justify-content:center;
  font-size:38px;font-weight:700;color:var(--brand-orange);
  overflow:hidden;position:relative;z-index:2;
}
.card__avatar img{width:100%;height:100%;object-fit:cover;}
.card__body{padding:16px 24px 26px;text-align:center;}
.card__name{font-size:22px;font-weight:700;}
.card__role{font-size:14px;color:var(--brand-green);font-weight:600;margin-top:4px;text-transform:uppercase;letter-spacing:.5px;}
.card__cat{display:inline-block;margin-top:10px;font-size:12px;background:rgba(232,70,30,.1);color:var(--brand-orange);padding:5px 12px;border-radius:20px;}
.card__actions{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:20px;}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px;border-radius:12px;border:none;cursor:pointer;font-size:14px;font-weight:600;text-decoration:none;transition:.25s;}
.btn--primary{background:var(--brand-orange);color:#fff;}
.btn--primary:hover{background:#c93a17;transform:translateY(-2px);}
.btn--green{background:var(--brand-green);color:#fff;}
.btn--green:hover{background:#3d8f23;transform:translateY(-2px);}
.btn--ghost{background:var(--brand-gray);color:var(--brand-dark);}
.btn--ghost:hover{background:#e8e8e8;transform:translateY(-2px);}
.btn--full{grid-column:1/-1;}
.card__contacts{margin-top:18px;text-align:left;font-size:14px;display:flex;flex-direction:column;gap:10px;}
.contact{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--brand-gray);border-radius:12px;color:inherit;text-decoration:none;transition:.2s;}
.contact:hover{background:#ececec;transform:translateX(3px);}
.card__footer{margin-top:18px;font-size:12px;color:#888;text-align:center;}
.card__footer a{color:var(--brand-green);text-decoration:none;}
.org{max-width:640px;}
.org__section{padding:18px 24px;border-top:1px solid #eee;}
.org__section h3{font-size:15px;color:var(--brand-orange);margin-bottom:8px;}
.org__row{display:flex;justify-content:space-between;font-size:14px;padding:6px 0;gap:12px;}
.org__row span:first-child{color:#777;}
@media (max-width:400px){.card__name{font-size:19px;}.card__actions{grid-template-columns:1fr;}}
